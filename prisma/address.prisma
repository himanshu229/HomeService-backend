model Address {
  id        String   @id @default(uuid())
  label     String
  street    String
  city      String
  state     String
  pincode   String
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookings Booking[]

  @@index([userId])
  @@map("addresses")
}
