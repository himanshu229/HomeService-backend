model User {
  id           String    @id @default(uuid())
  phone        String    @unique
  firstName    String
  lastName     String
  gender       Gender
  dob          DateTime
  email        String?   @unique
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses Address[]
  bookings  Booking[]
  reviews   Review[]

  @@index([phone])
  @@map("users")
}
