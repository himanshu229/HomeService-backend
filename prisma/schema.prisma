// Main schema file — datasource + generator only.
// All models live in prisma/models/  and enums in prisma/enums/
// Prisma merges every *.prisma file in this directory tree automatically.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
